{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "eslint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,css}\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "redirects:sync": "node --env-file-if-exists=.env.local ./node_modules/tsx/dist/cli.mjs scripts/syncRedirects.ts",
    "redirects:check": "node --env-file-if-exists=.env.local ./node_modules/tsx/dist/cli.mjs scripts/checkRedirect.ts",
    "test:css": "node --import tsx --test src/lib/sanitizeCss.test.ts",
    "test:images": "node --import tsx --test src/lib/photoUpload.test.ts src/lib/imageUrl.test.ts",
    "test:templates": "node --import tsx --test studio/pageTemplateLibrary/*.test.ts",
    "templates:migrate": "node --env-file-if-exists=.env.local ./node_modules/tsx/dist/cli.mjs studio/pageTemplateLibrary/migrateLegacyTemplates.ts",
    "test:preview": "node --import tsx --test src/lib/sanityDoc.test.ts src/components/PageSection.markers.test.tsx src/components/PageSection.mosaic.test.tsx src/components/PageSection.linklist.test.tsx",
    "test:layouts": "node --import tsx --test studio/layoutPresets/*.test.ts studio/layoutPresets/*.test.tsx"
  },
  "dependencies": {
    "@portabletext/react": "^8.0.1",
    "@sanity/image-url": "^2.1.1",
    "@sanity/vision": "6.22.0",
    "@vercel/global-config": "^1.5.1",
    "drizzle-orm": "^0.45.4",
    "framer-motion": "^14.9.0",
    "lucide-react": "^1.68.0",
    "next": "16.4.3",
    "next-sanity": "^13.4.0",
    "postcss": "^8.5.33",
    "postgres": "^4.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-icons": "5.7.0",
    "sanitize-html": "^2.17.0",
    "sanity": "6.22.0",
    "styled-components": "^6.1.18"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/turbopack": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prettier": "^3.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "prettier": {
    "bracketSpacing": false,
    "printWidth": 100,
    "semi": false,
    "singleQuote": true
  }
}
