# Copy this file to .env and fill in the values below (Sanity Studio is a
# Vite app — only SANITY_STUDIO_*-prefixed vars reach its browser bundle).

# Which Sanity project/dataset this Studio manages. Defaults to this repo's
# current dev project ("u0ztn8kn" / "production") if unset — set both when
# pointing this Studio at a different project (e.g. the client's own, once
# created at sanity.io/manage). Get the projectId from that project's
# Settings page. MUST match NEXT_PUBLIC_SANITY_PROJECT_ID/
# NEXT_PUBLIC_SANITY_DATASET in apps/web/.env.local.example — Studio and the
# web app have to agree on which project/dataset they're both reading from.
# SANITY_STUDIO_PROJECT_ID=
# SANITY_STUDIO_DATASET=

# The Studio's own header/title (top-left, next to the logo). Cosmetic only
# — defaults to "Freedom Motors" if unset.
# SANITY_STUDIO_TITLE=

# Where the web app runs — the Presentation Tool preview loads this URL in
# its iframe, and sends editors here (via /api/draft-mode/enable) after
# validating their preview secret. Defaults to the local Next.js dev server
# if unset; set this to the deployed site's URL for a deployed Studio.
# SANITY_STUDIO_PREVIEW_URL=http://localhost:3000

# Hosts the Custom HTML Section's <script src="..."> is allowed to load
# from — a small, explicit allowlist, comma-separated, checked by hostname
# (exact match or subdomain; e.g. "js.hsforms.net" also matches
# "sub.js.hsforms.net" but not "js.hsforms.net.evil.com"). Defaults to empty
# (no ad-hoc third-party scripts allowed) if unset. Google Tag Manager and
# HubSpot forms embedded site-wide don't go through this — it's for one-off
# per-campaign embeds (a widget, a pixel) added via the section itself.
#
# MUST be kept in sync with the web app's TRUSTED_SCRIPT_HOSTS
# (apps/web/.env.local.example) — same value, different env var name because
# Studio (Vite) only exposes SANITY_STUDIO_*-prefixed vars to its bundle.

SANITY_STUDIO_TRUSTED_SCRIPT_HOSTS=localhost,js.hsforms.net,js.hs-scripts.com,js-na1.hs-scripts.com
NEXT_PUBLIC_SANITY_PROJECT_ID=sp8bk444
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_STUDIO_TITLE=Freedom Motor