# ---------------------------------------------------------------
# .gitignore for the whole repo — the Next.js site and the embedded
# Sanity Studio both live at the root (formerly apps/web + apps/studio,
# whose own .gitignore rules are merged in here).
# ---------------------------------------------------------------

# Dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Lock files (team decision: not tracked)
package-lock.json
yarn.lock
pnpm-lock.yaml
npm-shrinkwrap.json

# Environment files / secrets — never commit. Keep the *.example templates.
.env
.env.*
# (from the old apps/web/.gitignore: any other .env-prefixed file, e.g. .envrc)
.env*
*.local
!.env.example
!.env.*.example
!.env.local.example
*.pem
*.key
certificates/*
!certificates/.gitkeep

# Build output & framework caches
.next/
out/
build/
dist/
.sanity/
.turbo/
.vercel
.cache/
*.tsbuildinfo
next-env.d.ts

# Sanity dataset exports / backups (large binaries, not code)
exports/
*.tar.gz
*.tgz

# Logs & debug
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Test coverage
coverage/

# OS / editor junk
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Stray dev-time screenshot, not part of the app
/image.png

# Local dev-only tool (audits the code against the client proposal), not part of the app
/audit-page-builder-commitments.mjs
