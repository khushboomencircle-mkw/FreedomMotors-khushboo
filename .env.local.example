# Copy this file to .env.local and fill in the values below.
# .env.local is gitignored — never commit real secrets.

# Which Sanity project/dataset this site reads from. Public, non-secret
# identifiers (NEXT_PUBLIC_ on purpose) — <SanityLive />/<VisualEditing />
# connect straight from the browser, so these end up in client-side JS
# regardless. Defaults to this repo's current dev project
# ("u0ztn8kn" / "production") if unset — set both when pointing this site at
# a different project (e.g. the client's own, once created at
# sanity.io/manage). Get the projectId from that project's Settings page.
# MUST match apps/studio/.env.example's SANITY_STUDIO_PROJECT_ID/
# SANITY_STUDIO_DATASET — the web app and Studio have to agree on which
# project/dataset they're both reading from.
# NEXT_PUBLIC_SANITY_PROJECT_ID=
# NEXT_PUBLIC_SANITY_DATASET=

# Required for live preview (Presentation Tool / click-to-edit / shared
# preview links). Reading unpublished drafts is an authenticated operation.
#
# Create it at https://sanity.io/manage → project "u0ztn8kn" → API → Tokens
# → Add API token → role "Viewer" (Viewer can read drafts but not write —
# the web app never needs to write to Sanity, so don't use a higher role).
#
# Without this, the site still works normally (published content, live
# auto-refresh on publish) — only the Presentation Tool preview is affected:
# /api/draft-mode/enable will refuse to turn preview on until this is set.
SANITY_API_READ_TOKEN=

# Where Sanity Studio is running, for the "Edit in Studio" link that Visual
# Editing's click-to-edit overlay opens. Defaults to the local Studio dev
# server if unset — only needed if Studio runs somewhere else (e.g. its
# deployed *.sanity.studio URL in production).
# SANITY_STUDIO_URL=http://localhost:3333

# Required for the Google Reviews Section (Trustindex widget) to actually show
# reviews. This is the install script URL from your Trustindex dashboard →
# your widget → Get Code — the <script src="..."> tag, separate from the
# data-pid value entered per-section in Studio. It's the same one script for
# every Google Reviews Section on the site (Trustindex loads whichever widget
# each data-pid points to). Without it, the section renders nothing rather
# than an empty box.
NEXT_PUBLIC_TRUSTINDEX_LOADER_SRC=

# Hosts the Custom HTML Section's <script src="..."> is allowed to load
# from — a small, explicit allowlist, comma-separated, checked by hostname
# (exact match or subdomain; e.g. "js.hsforms.net" also matches
# "sub.js.hsforms.net" but not "js.hsforms.net.evil.com"). Server-only (no
# NEXT_PUBLIC_ prefix — sanitizeHtml.ts runs server-side), and defaults to
# empty (no ad-hoc third-party scripts allowed) if unset. Google Tag Manager
# and HubSpot forms embedded site-wide don't go through this — it's for
# one-off per-campaign embeds (a widget, a pixel) added via the section
# itself.
#
# MUST be kept in sync with Studio's SANITY_STUDIO_TRUSTED_SCRIPT_HOSTS
# (apps/studio/.env.example) — same value, different env var name because
# that one needs the SANITY_STUDIO_ prefix to reach Studio's Vite bundle.
# TRUSTED_SCRIPT_HOSTS=localhost,js.hsforms.net,js.hs-scripts.com,js-na1.hs-scripts.com

# ── Vehicle inventory database (Postgres via Supabase + Drizzle) ───────────
# Both of the connection strings below use the SAME role/credentials from
# your Supabase project — Project Settings → Database → Connection string.
# Neither is safe to be public: both let whoever holds them read and write
# every row in this database, bypassing Row Level Security entirely (RLS is
# enabled on every table with no policies, so it blocks everything for any
# OTHER role — but these are not that role). Never prefix either with
# NEXT_PUBLIC_.
#
# Required for src/db/client.ts (the app's own runtime queries). Use the
# "Transaction" pooler connection string (port 6543, `?pgbouncer=true` in the
# URL), not the direct one — see the comment in src/db/client.ts for why.
# Without this, any code importing `db` from src/db/client.ts throws on
# first use.
DATABASE_URL=

# Required for drizzle.config.ts (schema migrations only — `drizzle-kit
# generate`/`migrate`, run by a person, not the deployed app). Use the
# "Direct connection" connection string (port 5432), not the pooled one —
# see the comment in drizzle.config.ts for why. `drizzle-kit generate` alone
# doesn't need a real, reachable value (it only diffs the TypeScript schema
# against the last migration), but `drizzle-kit migrate` does.
DIRECT_URL=

# Not consumed by any code in this task — reserved for if/when something
# needs Supabase's own API (Storage, Auth, etc.) instead of a direct Postgres
# connection, e.g. the future photo-download pipeline reading from a Storage
# bucket. SUPABASE_SERVICE_ROLE_KEY is a JWT, not a Postgres role, and is NOT
# what DATABASE_URL/DIRECT_URL's role is — see the comment in src/db/client.ts.
# Treat it as a secret: it bypasses RLS for anything that authenticates with
# it through Supabase's API, same as DATABASE_URL does for direct Postgres
# access. Both found in Project Settings → API.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# ── Studio-editable redirects (src/lib/redirects.ts, src/proxy.ts) ─────────
# A `redirect` document published/unpublished in Studio fires a Sanity
# webhook that hits /api/redirects/sync here, which re-reads every active
# redirect and writes the flattened map to Vercel's Global Config (formerly
# "Edge Config" — see @vercel/global-config's README). proxy.ts reads that
# map on every request. None of this is set up automatically — see the
# Studio and Vercel dashboard steps below.

# The shared secret /api/redirects/sync checks against the
# `x-sanity-webhook-secret` header. Generate any long random value, set it
# here, and set the SAME value as a custom header named
# `x-sanity-webhook-secret` on the webhook you create by hand at
# manage.sanity.io → your project → API → Webhooks (URL:
# https://<your-deployed-site>/api/redirects/sync, Dataset: production,
# Trigger on: Create/Update/Delete, Filter: _type == "redirect", HTTP
# method: POST). Without this, the sync route refuses every request with
# 401 — the live site keeps serving whatever redirect map was last synced.
SANITY_REDIRECTS_WEBHOOK_SECRET=

# A Vercel Access Token (vercel.com/account/tokens) used server-only by the
# sync route/script to write to Global Config via Vercel's REST API — the
# read-only @vercel/global-config SDK can't write. Scope it to the team that
# owns this project if you can. Without this, both the webhook sync route
# and `npm run redirects:sync` fail (reading redirects from Sanity still
# works; only the write to Vercel fails).
VERCEL_API_TOKEN=

# Only needed if this Vercel project is under a team (most are) — the
# team's ID or slug, from vercel.com/<team>/~/settings or the team picker
# URL. Omit it only for a personal-account project.
# VERCEL_TEAM_ID=

# The target Global Config store's ID, from its page in the Vercel
# dashboard (Storage → your Global Config → Settings). Create the store by
# hand first if one doesn't exist yet, and connect it to this project so
# GLOBAL_CONFIG below gets populated automatically in every deployed
# environment.
GLOBAL_CONFIG_ID=

# The Global Config connection string @vercel/global-config's `get()` reads
# from at request time (src/proxy.ts). Vercel sets this automatically in
# every deployed environment once the store above is connected to this
# project — you only need to set it here for local dev, by copying the
# connection string from the store's Vercel dashboard page (or running
# `vercel env pull .env.local` after connecting it). Without this,
# proxy.ts's lookup throws on every request — harmless (it falls through to
# normal routing) but means no redirect ever fires locally.
# GLOBAL_CONFIG=
