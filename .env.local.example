# Copy this file to .env.local and fill in the values. Never commit .env.local.

# ── Sanity ─────────────────────────────────────────────────────────────────
# These five are the only settings the app needs, and none has a built-in default.
# NEXT_PUBLIC_SANITY_PROJECT_ID, NEXT_PUBLIC_SANITY_DATASET and TRUSTED_SCRIPT_HOSTS (below) are checked at
# startup: the site, the Studio and the CLI stop with a clear message if one is not set.
# SANITY_API_READ_TOKEN (live preview) and SANITY_API_WRITE_TOKEN (one-off scripts) are only needed by those
# features, which say so when the token is missing.

# Project ID and dataset, used by the site, the Studio and the CLI
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=

# Read token for live preview: sanity.io/manage → API → Tokens, role "Viewer" (secret)
SANITY_API_READ_TOKEN=

# Write token for the one-off content scripts (e.g. studio/pageTemplateLibrary/migrateLegacyTemplates.ts):
# sanity.io/manage → API → Tokens, role "Editor" (secret)
SANITY_API_WRITE_TOKEN=

# ── Site address (sitemap.xml and robots.txt) ─────────────────────────────────
# The public address of the LIVE website, with https:// and no trailing slash, e.g. https://www.example.com. The
# sitemap needs full addresses. Set it in the hosting environment for Production; leave it unset for Staging and
# previews (they use their own address). Not a secret. If it is unset on Vercel, the production domain Vercel knows
# about is used, which may be the *.vercel.app address rather than the custom domain, so set it explicitly.
# robots.txt asks search engines to stay out of everything except the Production environment.
# NEXT_PUBLIC_SITE_URL=

# ── Page sections ──────────────────────────────────────────────────────────
# Hosts allowed to load <script src> in Custom HTML sections, comma-separated. Must be set; leave it empty
# (TRUSTED_SCRIPT_HOSTS=) to allow none. Example: localhost,js.hsforms.net,js.hs-scripts.com,js-na1.hs-scripts.com
TRUSTED_SCRIPT_HOSTS=

# ── Database: Supabase Postgres + Drizzle ─────────────────────────────────
# Two connection strings, both from Supabase → the project → Connect, on the same pooler host. They differ
# only in port: do not swap them. Use the pair of the environment you are running (each is its own project):
#   Development: fmi-website-dev   ·   Staging: fmi-website-staging   ·   Production: fmi-website
#
# The app's own queries — "Transaction pooler", port 6543 (secret):
#   postgresql://postgres.<project-ref>:<password>@<aws-region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Migrations (npm run db:migrate) — "Session pooler", port 5432 (secret):
#   postgresql://postgres.<project-ref>:<password>@<aws-region>.pooler.supabase.com:5432/postgres
DIRECT_URL=

# ── Vehicle photos: Supabase Storage ───────────────────────────────────────
# Project URL, e.g. https://<project-ref>.supabase.co. Also lets the image optimizer load photos from the PUBLIC
# bucket below (and only that bucket). Unset = no Supabase images are allowed.
# SUPABASE_URL=

# Name of the PUBLIC bucket that holds vehicle photo originals. No default: required once SUPABASE_URL is set.
# Create it in Supabase → Storage → New bucket, with "Public bucket" switched ON, then put its name here.
SUPABASE_STORAGE_BUCKET=vehicle-photos

# Needed only by the photo upload job, never by the website. Server-only (secret): never give it a NEXT_PUBLIC_
# prefix and never put it in a component or a client file.
# SUPABASE_SERVICE_ROLE_KEY=

