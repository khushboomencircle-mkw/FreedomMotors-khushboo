# Copy this file to .env.local and fill in the values. Never commit .env.local.

# ── Sanity ─────────────────────────────────────────────────────────────────
# Project ID and dataset (default: sp8bk444 / production), used by the site, the Studio and the CLI
# NEXT_PUBLIC_SANITY_PROJECT_ID=
# NEXT_PUBLIC_SANITY_DATASET=

# Read token for live preview: sanity.io/manage → API → Tokens, role "Viewer" (secret)
SANITY_API_READ_TOKEN=

# Studio address for click-to-edit links (default: /studio on this site)
# SANITY_STUDIO_URL=https://your-studio.sanity.studio/studio

# Title shown in the Studio header
# SANITY_STUDIO_TITLE=

# Site the Studio's Preview tab opens (default: the site the Studio runs on)
# SANITY_STUDIO_PREVIEW_URL=

# ── Page sections ──────────────────────────────────────────────────────────
# Trustindex script URL for the Google Reviews section (Trustindex → your widget → Get Code)
NEXT_PUBLIC_TRUSTINDEX_LOADER_SRC=

# Hosts allowed to load <script src> in Custom HTML sections, comma-separated (default: none)
# TRUSTED_SCRIPT_HOSTS=localhost,js.hsforms.net,js.hs-scripts.com,js-na1.hs-scripts.com

# ── Database: Supabase Postgres + Drizzle (not used by the site yet) ──────
# Pooled "Transaction" connection string, port 6543 (secret)
DATABASE_URL=

# "Direct connection" string for Drizzle migrations, port 5432 (secret)
DIRECT_URL=

# Supabase API, reserved for later (secret)
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# ── Redirects: Sanity webhook → Vercel Global Config ──────────────────────
# Shared secret the Sanity webhook sends in the x-sanity-webhook-secret header (secret)
SANITY_REDIRECTS_WEBHOOK_SECRET=

# Vercel access token that writes the redirect map (secret)
VERCEL_API_TOKEN=

# Vercel team ID or slug (only for team projects)
# VERCEL_TEAM_ID=

# Global Config store ID (Vercel → Storage → your Global Config → Settings)
GLOBAL_CONFIG_ID=

# Global Config connection string, set automatically on Vercel (only needed locally)
# GLOBAL_CONFIG=
